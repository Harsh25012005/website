# Public origin of the deployed site, without a trailing slash.
# Used for canonical URLs, hreflang alternates, the sitemap and OG image URLs.
# Getting this wrong means search engines index localhost — set it per environment.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form (/api/contact) ---

# Resend API key. Create one at https://resend.com/api-keys.
# Without it the endpoint returns 500 and logs why — the form cannot send.
# Server-only: never prefix this with NEXT_PUBLIC_, or it ships to the browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. Defaults to `site.email` when unset.
CONTACT_TO_EMAIL=design.harsh25@gmail.com

# Sender address. Must be on a domain verified at https://resend.com/domains.
# Leave unset to use Resend's shared `onboarding@resend.dev`, which can only
# deliver to the address the Resend account was created with — fine until a
# custom domain is verified.
# CONTACT_FROM_EMAIL=Harsh Vaghela <hello@your-domain.com>
